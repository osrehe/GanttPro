# Copia este archivo a .env y ajusta los valores.

# Puerto del host que publica Postgres (docker compose lo lee de este archivo).
# Cámbialo si el 5432 ya está ocupado en tu máquina y ajusta las URLs de abajo.
POSTGRES_PORT=5432

# Base de datos (Postgres 16 levantado con `docker compose up -d`)
DATABASE_URL="postgresql://ganttpro:ganttpro@localhost:5432/ganttpro?schema=public"
# Base de datos usada por los tests de integración (creada por docker/postgres/init)
DATABASE_URL_TEST="postgresql://ganttpro:ganttpro@localhost:5432/ganttpro_test?schema=public"

# Auth.js: secreto para firmar la sesión. Genera uno con `npx auth secret` u `openssl rand -base64 32`.
AUTH_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
# Necesario fuera de Vercel para aceptar el host de la petición.
AUTH_TRUST_HOST=true

# Contraseña de los usuarios de ejemplo que crea `npm run db:seed`
# (admin@ganttpro.local, editor@ganttpro.local, lector@ganttpro.local).
SEED_PASSWORD="GanttPro2026!"

# Exportación PDF (Paso 9). Opcionales.
# URL con la que el propio servidor abre /print/gantt en Chromium (por defecto, el origen de la petición).
# PRINT_BASE_URL="http://localhost:3000"
# Ruta a un Chromium/Chrome ya instalado (por defecto usa el que descarga Puppeteer).
# PUPPETEER_EXECUTABLE_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"
